<https://www.w3id.org/conservation/terms/metadata/A8ABBA> a skos:Concept ;
    doc:TextOrUri "Text" ;
    doc:Verpflichtungsgrad "bedingte Pflicht" ;
    doc:Wiederholbar "Nein" ;
    skos:altLabel "Zeitpunkt der Erfassung"@de ;
    skos:broader <https://www.w3id.org/conservation/terms/metadata/G5TA85> ;
    skos:definition """Angaben ob es sich bei dem erfassten Zustand um den Zeitpunkt vor, nach oder zwischen einem konservatorisch-restauratorischen Eingriff handelt oder der Zustand beispielsweise im Zuge eines Monitorings, ohne anschließendem Eingriff, erfasst wurde. \r\r
\r\r
Der Zustand vor und nach einem Eingriff sollte dabei verpflichtend erfasst werden. Weitere Zustandserfassungen sind bei Bedarf möglich."""@de ;
    skos:inScheme <https://www.w3id.org/conservation/terms/metadata> ;
    skos:notation "A8ABBA" ;
    skos:prefLabel "Erfassungszeitpunkt"@de .

