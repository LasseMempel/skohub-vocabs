\r\r
Beispiel: Farbe, Form, Besonderheit beim Aussehen"""@de ;
    skos:inScheme <https://www.w3id.org/conservation/terms/metadata> ;
    skos:notation "BGC9F3" ;
    skos:prefLabel "Weitere Objekteigenschaften"@de .

